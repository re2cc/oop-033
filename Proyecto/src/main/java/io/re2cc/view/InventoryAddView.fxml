<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="300.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.re2cc.controller.InventoryAddController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="0.0">
         <children>
            <Label prefHeight="17.0" prefWidth="70.0" text="Item">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" top="6.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="txtName" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets right="2.0" top="2.0" />
               </HBox.margin>
            </TextField>
         </children>
         <opaqueInsets>
            <Insets top="5.0" />
         </opaqueInsets>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="0.0">
         <children>
            <Label prefHeight="17.0" prefWidth="70.0" text="Quantity">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" top="7.0" />
               </HBox.margin>
            </Label>
            <TextField fx:id="txtQuantity" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets right="2.0" top="7.0" />
               </HBox.margin>
            </TextField>
         </children>
         <opaqueInsets>
            <Insets top="5.0" />
         </opaqueInsets>
      </HBox>
      <HBox alignment="BOTTOM_RIGHT" prefHeight="0.0" prefWidth="0.0" VBox.vgrow="ALWAYS">
         <opaqueInsets>
            <Insets top="5.0" />
         </opaqueInsets>
         <children>
            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave" text="Save">
               <HBox.margin>
                  <Insets bottom="2.0" right="2.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
