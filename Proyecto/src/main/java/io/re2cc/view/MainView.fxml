<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
  <children>
      <HBox prefHeight="0.0" prefWidth="0.0">
         <children>
          <MenuBar HBox.hgrow="ALWAYS">
            <menus>
              <Menu mnemonicParsing="false" text="Menu">
                <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleSave" text="Save (Serialize)" />
                  <MenuItem mnemonicParsing="false" onAction="#handleGenerateReport" text="Generate report" />
                </items>
              </Menu>
            </menus>
          </MenuBar>
            <Button fx:id="btnNextDay" mnemonicParsing="false" onAction="#handleNextDay" text="Next day" textAlignment="RIGHT">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Clients">
               <content>
                  <VBox>
                     <children>
                        <TableView fx:id="tblClients" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colClientId" prefWidth="59.0" text="ID" />
                            <TableColumn fx:id="colClientName" prefWidth="209.0" text="NAME" />
                              <TableColumn fx:id="colClientMembership" prefWidth="89.0" text="MEMBERSHIP" />
                              <TableColumn fx:id="colClientExpiration" prefWidth="88.0" text="EXPIRATION" />
                              <TableColumn fx:id="colClientAutoRenew" prefWidth="86.0" text="AUTO-RENEW" />
                              <TableColumn fx:id="colClientAccessStatus" prefWidth="108.0" text="ACCESS STATUS" />
                          </columns>
                        </TableView>
                        <HBox alignment="TOP_RIGHT" prefHeight="0.0" prefWidth="0.0">
                           <children>
                              <Button fx:id="btnClientAdd" mnemonicParsing="false" onAction="#handleClientAdd" text="Add" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="btnClientEdit" mnemonicParsing="false" onAction="#handleClientEdit" text="Edit" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" left="20.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Access">
               <content>
                  <VBox alignment="CENTER">
                     <children>
                        <TextField fx:id="txtAccessClientId" promptText="CLIENT ID">
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <HBox alignment="TOP_CENTER" prefHeight="0.0" prefWidth="0.0">
                           <children>
                              <Button fx:id="btnAccessEnter" mnemonicParsing="false" onAction="#handleAccessEnter" text="Enter" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="btnAccessExit" mnemonicParsing="false" onAction="#handleAccessExit" text="Exit" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" left="20.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Membership">
               <content>
                  <VBox>
                     <children>
                        <TableView fx:id="tblMemberships" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colMembershipType" prefWidth="406.0" text="TYPE" />
                              <TableColumn fx:id="colMembershipDuration" prefWidth="126.0" text="Duration (Days)" />
                              <TableColumn fx:id="colMembershipPrice" prefWidth="107.0" text="PRICE" />
                           </columns>
                        </TableView>
                        <HBox alignment="TOP_RIGHT" prefHeight="0.0" prefWidth="0.0">
                           <children>
                              <Button fx:id="btnMembershipAdd" mnemonicParsing="false" onAction="#handleMembershipAdd" text="Add" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="btnMembershipEdit" mnemonicParsing="false" onAction="#handleMembershipEdit" text="Edit" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" left="20.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Inventory">
               <content>
                  <VBox>
                     <children>
                        <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colInventoryItem" prefWidth="503.0" text="ITEM" />
                              <TableColumn fx:id="colInventoryQuantity" prefWidth="136.0" text="QUANTITY" />
                           </columns>
                        </TableView>
                        <HBox alignment="TOP_RIGHT" prefHeight="0.0" prefWidth="0.0">
                           <children>
                              <Button fx:id="btnInventoryAdd" mnemonicParsing="false" onAction="#handleInventoryAdd" text="Add" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="btnInventoryEdit" mnemonicParsing="false" onAction="#handleInventoryEdit" text="Edit" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" left="20.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="Clases">
               <content>
                  <VBox>
                     <children>
                        <HBox VBox.vgrow="ALWAYS">
                           <children>
                              <TableView fx:id="tblClassDates" HBox.hgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colClassDate" prefWidth="113.0" text="DATE" />
                                    <TableColumn fx:id="colClassDateQuantity" prefWidth="113.0" text="QUANTITY" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <TableView fx:id="tblClassDetails" HBox.hgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colClassName" prefWidth="75.0" text="CLASS" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </HBox>
                        <HBox alignment="TOP_RIGHT" prefHeight="0.0" prefWidth="0.0">
                           <children>
                              <Button fx:id="btnClassAdd" mnemonicParsing="false" onAction="#handleClassAdd" text="Add" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                              <Button fx:id="btnClassEdit" mnemonicParsing="false" onAction="#handleClassEdit" text="Edit" textAlignment="RIGHT">
                                 <HBox.margin>
                                    <Insets bottom="1.0" left="20.0" top="1.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
        </tabs>
      </TabPane>
  </children>
</VBox>
